  "narrative": {
    "northStar": "Paired channel workstation",
    "overview": "A light, quiet operating surface for independent laboratory outputs. White instrument panels, restrained green actions, and readable numeric fields support deliberate edits. English labels and local system fonts keep the interface usable on Windows and Ubuntu without network assets.",
    "keyCharacteristics": [
      "Equal visual weight for both channels.",
      "Values, units, draft state, and output state remain distinct.",
      "Flat surfaces and compact, gently rounded controls."
    ],
    "rules": [
      {
        "name": "The Explicit State Rule",
        "body": "Color reinforces a written state; it never substitutes for one.",
        "section": "colors"
      },
      {
        "name": "The Number and Unit Rule",
        "body": "Keep each editable quantity visibly paired with its unit.",
        "section": "typography"
      },
      {
        "name": "The Separate Actions Rule",
        "body": "Applying parameters and switching an output are separate actions. Dirty drafts disable Output On; Output Off stays available while connected and idle.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep both channels equally prominent and independently actionable.",
      "Do retain explicit units and written states at every viewport width.",
      "Do preserve unsent drafts when updating connection or cached command state.",
      "Do stack quantity fields on narrow screens instead of compressing their contents."
    ],
    "donts": [
      "Don't represent simulated or accepted commands as measured hardware state.",
      "Don't combine Apply with Output On.",
      "Don't use color alone to communicate selection, failure, or unknown state."
    ]
  }
