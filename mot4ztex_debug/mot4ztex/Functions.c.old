}

unsigned cDAC8(val v)
{
  double aux=v.fval;
  unsigned dacout,neg=0;

  if(aux<0)
    {
      neg=1;
      aux=-aux;
    }

  dacout=(aux*32768./15.);

  if(neg)
    dacout=0x10000-dacout;

  return dacout;
}


