LOOP

COMMENT

Launching sequence for tmot5
in progress testing version

ENDCOMMENT

INIT

#	Bias_X =4.200				(31)
#	Bias_Y =5.500				(33)
#	Bias_Z =4.200				(35)

	DDS1 [0]				(2)
	
	DDS5 [0]				(14)

ENDINIT

INNER

## Sequence to ckeck the signal of AOM 3D UP and AOM 3D DOWN ##

##################################
#            3D MOT              #5
##################################

#TURN ON SHIM FIELDS AND 3D MOT MAGNETS#

+20us 3DMOT_Coils = ON					(67) #MOT coils on
+20us DDS1 [13]						(2) # scan from -1.9---3.0
+20us DDS4 [23]						(8)
+20us DDS5 [5]						(14) # -2.6 GAMMA

#TURN ON 3D MOT LIGHT#
+10us TTL 2DMOT_Shutter = ON 				(48) #2D MOT shutter up. 2D MOT on
+10us 3DMOT_Up_Shutter = ON 				(46) #shutter up. up AOM
+10us 3DMOT_Down_Shutter = ON 				(47) #shutter up. down AOM
+10us Detection_Shutter=OFF				(45) #shutter up
+10us Raman_Dw_Shutter=OFF				(40) #shutter up
+10us Raman_Up_Shutter=OFF				(41) #shutter up
+10us Repump_MOT_Shutter = ON				(42) #shutter up. repump
+10us Repump_push_Shutter = OFF			(43) #shutter up. repump

#+10us AOM_3DMOT_Up= OFF					(51) #AOM 3D_Up enabled

#+10us AOM_3DMOT_Down= OFF				(53) #AOM 3D_Dw enabled
+10us AOM_Raman1= OFF 					(49) #AOM repump enabled
+10us AOM_Raman2= ON 					(50) #AOM Raman2 enabled
#WARNING. OUTPUT LIGHT POSSIBLE#

#3D MOT LIGHT INTENSITY and frequency#
+100us AOM_3DMOT_Up =0.740	(21) #up beams. power set 950 650 550  #24.5 mW 740
###################################################################################### Detuning between UP and DOWN for launching
+30us AOM_3DMOT_Down =0.517		(20) #down beams. power set 950 500 #26 mW 380 0.5 
########################################################################################
#+30us VCA_3DMOT_Down =2.3				(26) #2.3
+20us AOM_Detection =5				(22) #thermalization
+10us AOM_Det= OFF					(52)
+30us AOM_Raman1 =0.950					(23) #repump. power set 30
+20us AOM_Raman2 =0.950					(24) #thermalization


#WARNING. OUTPUT LIGHT GUARANTEED#

#+10us Detection_Shutter=ON				(45) #shutter up
#+10us AOM_Det= OFF					(52)
################################
#       3D MOT release		#
################################


# ********** molasses ************************************
+350ms TTL 2DMOT_Shutter = OFF			(48) #loading time 800 350

#+1us Exp_trig= ON      	   				(60)
#+20us Bias_X =5.700					(31) #Bias coils in X direction 5750 5150
#+20us Bias_Y =4.600     			    	(33) #Bias coils in Y direction 4690 4800 
#+20us Bias_Z =2.800	      				(35) #Bias coils in Z direction 2520 2800
+55us TTL 3DMOT_Coils = OFF				(67) #MOT coils off, delay 3.23 10 3
#+1us DDS1 [2]						(1) # -2GAMMA
#+1us DDS1 [16]						(2) # -4 GAMMA
#+1us VCA_3DMOT_Down =2.0				(26) 

#********** launching *********************************** 
+1us DDS4 [28]						(7)  #changes freq for launch 6200 6500 2
#+0.5ms AOM_Raman1 =0.000 				(23)
+36ms DDS4 trigger = ON				(12) #Change the state from here 18 28 32
+1us Exp_trig= ON      	   			(60)
+10us bais Y=5			(33)
#+1us DDS1 [13]						(1) # -2GAMMA
#+1us DDS1 trigger = ON					(6) # -1.9 GAMMA 10

# ********** frequency ramp ***************************************

+400us DDS1 [117]					(2) # Freq ramp 710 -1.9----15GAMMA ##Launchingtime## best parameter:450, optimal gamma end value: -32 GAMMA 12.35 microKelvin 490 3.8uK

##+600us DDS1 trigger = ON					(6) # -1.9 GAMMA 10
+20us DDS1 ramp = ON 					(5)  

# ********** power ramp ***************************************
